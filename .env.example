# DeepSeek is reached through the dev middleware at POST /api/ai, which reads
# these from the server's environment (D-006). Copy this file to `.env.local`;
# that one is git-ignored, this one is not.
#
# Nothing here is prefixed VITE_ on purpose: a VITE_ variable is copied into the
# browser bundle, and the key must never be.

# Required. Without it the endpoint answers 503 not_configured and the UI says so.
DEEPSEEK_API_KEY=

# Optional. Defaults: https://api.deepseek.com and deepseek-chat.
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# Optional, for the offline checks only: shortens the 30 s upstream timeout so a
# hanging stub does not make the suite wait half a minute (scripts/ai-checks.mjs).
# DEEPSEEK_TIMEOUT_MS=1500

# ---- other providers (D-061) ---------------------------------------------
#
# Every provider is optional: one with no key is listed in the picker but
# cannot be selected. The keys stay on the server; the browser only ever asks
# for a provider and a model. Full details: docs/development/backend/AI-PROVIDERS.md

# OpenAI — https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=gpt-4o-mini,gpt-4o
# OPENAI_TIMEOUT_MS=30000

# Anthropic — https://api.anthropic.com/v1/messages (its own protocol; the
# server translates it, the browser does not)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODELS=claude-sonnet-4-5,claude-haiku-4-5
# ANTHROPIC_TIMEOUT_MS=30000
# ANTHROPIC_MAX_TOKENS=4096

# OpenRouter — https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODELS=openai/gpt-4o-mini,deepseek/deepseek-chat
# OPENROUTER_TIMEOUT_MS=30000
# OPENROUTER_REFERER=
# OPENROUTER_TITLE=

# Kimi (Moonshot) — https://api.moonshot.cn/v1/chat/completions
KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODELS=kimi-k2.6,kimi-k2.5
# KIMI_TIMEOUT_MS=30000

# Which provider answers when a request names none. Falls back to the first
# provider that has a key.
# AI_DEFAULT_PROVIDER=deepseek
# AI_DEFAULT_MODEL=deepseek-chat

# Standalone API host (D-055): `npm run api` serves the same three endpoints on
# a plain node:http server. Node loads this file with --env-file-if-exists, and
# a variable the shell already set wins.
PORT=8787

# Phase 1 foundation (D-055, P1-2). Empty until the service exists; none is
# prefixed VITE_ — every one of these stays on the server.
# Postgres connection string for Drizzle (P1-3). Local container example:
# postgres://postgres:thylas@127.0.0.1:55432/thylas
DATABASE_URL=
# Target bucket for signed direct uploads (N3). Reserved for a future S3 host.
STORAGE_BUCKET=
# Local root for uploaded bytes (P1-6). Empty = /api/files answers 503.
# Keep it outside the repo and git-ignored. Example: .tmp/uploads
STORAGE_DIR=
# CHORD identity provider issuer (N2). Empty = dev session source, which reads
# the `thylas_session` cookie in `dev:<userId>:<workspaceIds>` form (P1-5).
# Once set, protected endpoints fail closed with 401 until the IdP verifier exists.
CHORD_ISSUER=

# P1-7 chat persistence mode. `local` (default) keeps the browser envelope
# only; `api` syncs to /api/chat/state and needs DATABASE_URL + a session cookie.
# Not a secret — VITE_ variables are shipped to the browser on purpose.
VITE_CHAT_SOURCE=local

# Phase 2 A1 user persistence mode. `local` (default) keeps the browser
# envelope only; `api` reads/writes /api/user and needs a session cookie.
# Not a secret — VITE_ variables are shipped to the browser on purpose.
VITE_USER_SOURCE=local
