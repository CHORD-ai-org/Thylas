# DeepSeek is reached through the dev middleware at POST /api/ai, which reads
# these from the server's environment (D-006). Copy this file to `.env.local`;
# that one is git-ignored, this one is not.
#
# Nothing here is prefixed VITE_ on purpose: a VITE_ variable is copied into the
# browser bundle, and the key must never be.

# Required. Without it the endpoint answers 503 not_configured and the UI says so.
DEEPSEEK_API_KEY=

# Optional. Defaults: https://api.deepseek.com and deepseek-chat.
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# Optional, for the offline checks only: shortens the 30 s upstream timeout so a
# hanging stub does not make the suite wait half a minute (scripts/ai-checks.mjs).
# DEEPSEEK_TIMEOUT_MS=1500

# Standalone API host (D-055): `npm run api` serves the same three endpoints on
# a plain node:http server. Node loads this file with --env-file-if-exists, and
# a variable the shell already set wins.
PORT=8787

# Phase 1 foundation (D-055, P1-2). Empty until the service exists; none is
# prefixed VITE_ — every one of these stays on the server.
# Postgres connection string for Drizzle (P1-3).
DATABASE_URL=
# Target bucket for signed direct uploads (N3).
STORAGE_BUCKET=
# CHORD identity provider issuer, used to verify the session cookie (N2).
CHORD_ISSUER=
